# Copy to .env and fill in. .env is git-ignored. Nothing here is needed for the tests or the demo.
#
# A GitHub personal access token with the `models:read` permission, for `subfinder run`.
# Create one under Settings > Developer settings > Personal access tokens > Fine-grained tokens.
# This is not the same token `gh auth login` stores, which has no model permission.
GITHUB_MODELS_TOKEN=

# Optional
# SUBFINDER_MODEL=openai/gpt-4.1-mini

# Optional, for `subfinder serve-http`
# SUBFINDER_HTTP_TOKEN=
